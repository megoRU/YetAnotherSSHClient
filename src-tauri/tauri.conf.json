{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YASSH Client",
  "version": "4.0.1-rc.1",
  "identifier": "com.yash.client",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost https:; media-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 https://api.megoru.ru https://api.github.com https://raw.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$TEMP/**", "$HOME/**"]
      }
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "YetAnotherSSHClient Team",
    "copyright": "YASSH Client",
    "category": "DeveloperTool",
    "shortDescription": "YetAnotherSSHClient",
    "longDescription": "YetAnotherSSHClient — современный SSH/SFTP-клиент для разработчиков и системных администраторов.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      },
      "hardenedRuntime": false,
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "$schema": "https://schema.tauri.app/updater/2",
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2OTM5QzhCREM3MjFDMkUKUldRdUhITGNpNXlUNXE3eUY5aXVrQmlwWGlTTVFJTUdKRXlmYXp2dnJmTW9CL0lhUGpBYUlaTysK",
      "endpoints": [
        "https://raw.githubusercontent.com/megoRU/YetAnotherSSHClient/dev-v4.0.0/src-tauri/updater/latest.json"
      ],
      "prereleaseEndpoints": [
        "https://raw.githubusercontent.com/megoRU/YetAnotherSSHClient/dev-v4.0.0/src-tauri/updater/prerelease.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
