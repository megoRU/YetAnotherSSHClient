{
  "name": "yetanothersshclient",
  "private": true,
  "version": "4.6.2",
  "desktopName": "com.yash.client",
  "description": "A modern multi-platform SSH client built with Svelte and Tauri",
  "repository": {
    "type": "git",
    "url": "https://github.com/megoRU/YetAnotherSSHClient"
  },
  "author": "YetAnotherSSHClient Team <support@megoru.ru> (https://megoru.ru)",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run dev:tauri",
    "dev:tauri": "node scripts/tauri-dev.mjs",
    "dev:vite": "vite",
    "build": "tauri build",
    "build:vite": "vite build",
    "tauri": "tauri",
    "icons:tauri": "node scripts/generate-tauri-icons.mjs",
    "lint": "eslint .",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@lucide/svelte": "0.575.0",
    "@tauri-apps/api": "^2.12.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.13.6",
    "eslint": "^9.39.3",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.3.0",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "zod": "^4.6.7"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "megoRU",
        "repo": "YetAnotherSSHClient",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
