{
  "name": "yetanothersshclient",
  "private": true,
  "version": "4.0.4",
  "desktopName": "com.yash.client",
  "description": "A modern multi-platform SSH client built with React and Tauri",
  "repository": {
    "type": "git",
    "url": "https://github.com/megoRU/YetAnotherSSHClient"
  },
  "author": "YetAnotherSSHClient Team <support@megoru.ru> (https://megoru.ru)",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run dev:tauri",
    "dev:tauri": "node scripts/tauri-dev.mjs",
    "dev:vite": "vite",
    "build": "tauri build",
    "build:vite": "vite build",
    "tauri": "tauri",
    "icons:tauri": "node scripts/generate-tauri-icons.mjs",
    "lint": "eslint .",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.575.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "zod": "^3.25.76"
  },
  "build": {
    "publish": [
      {
        "provider": "github",
        "owner": "megoRU",
        "repo": "YetAnotherSSHClient",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
