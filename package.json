{
  "name": "yetanothersshclient",
  "private": true,
  "version": "2.4.2",
  "description": "A modern multi-platform SSH client built with React and Electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/megoRU/YetAnotherSSHClient"
  },
  "author": "YetAnotherSSHClient Team <support@megoru.ru> (https://megoru.ru)",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:win:x64": "npm run build && electron-builder --win nsis --x64",
    "package:win:arm64": "npm run build && electron-builder --win nsis --arm64"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.4",
    "lucide-react": "^0.575.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.yash.client",
    "productName": "YASSH Client",
    "executableName": "YASSH Client",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "megoRU",
        "repo": "YetAnotherSSHClient",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "artifactName": "YASSHClient-macos-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "public/icons/icon1024.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "nsis",
          "arch": "arm64"
        }
      ],
      "artifactName": "YASSHClient-windows-${arch}.${ext}",
      "icon": "public/icons/icon256.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "guid": "763c306d-e4c1-4b72-888e-6e8d2e85a67c",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "shortcutName": "YASSH Client",
      "include": "electron/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "YASSHClient-linux-${arch}.${ext}",
      "category": "Utility",
      "icon": "public/icons/icon256.png"
    }
  }
}
